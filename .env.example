# Same Postgres as Kritly platform (creates/uses schema "hris")
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kritly?schema=hris

PORT=4545

# Optional: shared workforce maker-checker via gateway
# WORKFORCE_API_URL=http://localhost:3000
# WORKFORCE_SERVICE_KEY=change-me-workforce-service
# HRIS_INTERNAL_KEY=change-me-hris-internal
# PUBLIC_GATEWAY_URL is optional; defaults to WORKFORCE_API_URL for the Approvals UI
# PLATFORM_LOGIN_URL=http://localhost:4201/login
# HRIS_PUBLIC_URL=http://localhost:4545

# Nai first show — mint assertions + GET /api/nai/* for nai-service
# NAI_INTERNAL_JWT_SECRET must match nai-service (Render: copy from commerce-automation-nai)
# NAI_INTERNAL_JWT_SECRET=dev-nai-internal-jwt-secret
# NAI_SERVICE_URL=http://127.0.0.1:3101
# Render: NAI_SERVICE_URL=https://commerce-automation-nai.onrender.com
# NAI_SERVICE_KEY=dev-shared-key
# HRIS_NAI_TENANT_ID=kritly

# Password reset email. Without SMTP_HOST/USER/PASS the reset link is printed to the server log.
# HRIS_PUBLIC_URL (above) is used to build the link — set it in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Kritly HRIS <no-reply@kritly.com>"

# Evidence file storage: S3 only, in every environment. Without these, file uploads
# fail (evidence links still work). There is no local-disk fallback.
# S3_BUCKET=
# S3_REGION=eu-north-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# EVIDENCE_S3_PREFIX=hris/evidence/
